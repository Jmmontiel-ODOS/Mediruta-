---
import CRM from '../layouts/CRM.astro';
---
<CRM titulo="Mis visitas" activa="visitas">
  <header class="cabecera">
    <div>
      <h1>Mis visitas</h1>
      <p class="sub">Los pacientes que tomaste, en el orden en que conviene atenderlos.</p>
    </div>
  </header>

  <section class="resumen">
    <div><b class="num" id="r-activas">0</b><span>por atender</span></div>
    <div><b class="num" id="r-tiempo">0 min</b><span>de recorrido estimado</span></div>
    <div><b class="num" id="r-resueltas">0</b><span>resueltas hoy</span></div>
  </section>

  <section class="ia">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 5.4L19 9l-5.2 1.6L12 16l-1.8-5.4L5 9l5.2-1.6zM19 15l.9 2.6 2.6.9-2.6.9L19 22l-.9-2.6-2.6-.9 2.6-.9z"/></svg>
    <div>
      <b>Ruta óptima con IA</b>
      <span>Ordenará tus visitas por gravedad, tráfico y cercanía en tiempo real. Por ahora el orden es: primero los más graves.</span>
    </div>
    <span class="pronto">Próximamente</span>
  </section>

  <h2>Ruta de hoy</h2>
  <ol class="ruta" id="ruta"></ol>

  <h2>Resueltas</h2>
  <ul class="hechas" id="hechas"></ul>
</CRM>

<style>
  .cabecera { margin-bottom: 20px; }
  h1 { margin: 0; font-size: 30px; font-weight: 800; letter-spacing: -0.02em; }
  .sub { margin: 4px 0 0; color: var(--tinta-3); font-size: 15px; }
  h2 { margin: 28px 0 12px; font-size: 17px; font-weight: 800; }

  .resumen { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; max-width: 760px; }
  .resumen div { display: grid; padding: 16px 18px; border-radius: var(--radio); background: var(--superficie); border: 1px solid var(--borde); }
  .resumen b { font-size: 28px; font-weight: 800; }
  .resumen span { font-size: 13px; color: var(--tinta-3); font-weight: 600; }

  .ia {
    display: flex; align-items: center; gap: 14px; max-width: 760px; margin-top: 14px; padding: 16px 18px; border-radius: var(--radio);
    background: linear-gradient(135deg, #f7f4ff, #f0f9f9); border: 1px solid #e4dcfb; color: #5a3fc0;
  }
  .ia div { flex: 1; display: grid; gap: 2px; }
  .ia b { font-size: 15px; }
  .ia span:not(.pronto) { font-size: 13px; color: var(--tinta-2); }

  .ruta { list-style: none; margin: 0; padding: 0; max-width: 760px; display: grid; }
  .ruta :global(li) { position: relative; display: flex; gap: 16px; padding-bottom: 14px; }
  .ruta :global(li::before) { content: ''; position: absolute; left: 17px; top: 38px; bottom: 0; width: 2px; background: repeating-linear-gradient(to bottom, var(--marca) 0 4px, transparent 4px 9px); }
  .ruta :global(li:last-child::before) { display: none; }
  .ruta :global(.n) { width: 36px; height: 36px; flex: none; display: grid; place-items: center; border-radius: 50%; color: #fff; font-weight: 800; font-size: 15px; }
  .ruta :global(.parada) {
    flex: 1; display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; padding: 14px 16px; border-radius: 14px;
    background: var(--superficie); border: 1px solid var(--borde); color: inherit; text-decoration: none; transition: box-shadow 0.15s;
  }
  .ruta :global(.parada:hover) { box-shadow: var(--sombra); }
  .ruta :global(.parada b) { font-size: 16px; }
  .ruta :global(.parada p) { grid-column: 1; margin: 0; font-size: 14px; font-weight: 600; color: var(--tinta-2); }
  .ruta :global(.parada small) { grid-column: 1; font-size: 12px; color: var(--tinta-3); }
  .ruta :global(.lado) { grid-column: 2; grid-row: 1 / span 3; display: grid; justify-items: end; align-content: space-between; gap: 8px; }
  .ruta :global(.min) { font-size: 20px; font-weight: 800; color: var(--marca-fuerte); }
  .ruta :global(.min small) { font-size: 12px; font-weight: 600; }

  .hechas { list-style: none; margin: 0; padding: 0; max-width: 760px; display: grid; gap: 8px; }
  .hechas :global(a) { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 12px; background: var(--superficie); border: 1px solid var(--borde); color: inherit; text-decoration: none; }
  .hechas :global(a b) { flex: 1; font-size: 14px; }
  .hechas :global(a span) { font-size: 13px; color: var(--tinta-3); }
  .hechas :global(.check) { width: 26px; height: 26px; flex: none; display: grid; place-items: center; border-radius: 50%; background: #e8f6ee; color: #1f7a4d; font-weight: 800; }

  .hechas :global(.vacio a), .ruta :global(.vacio a) { color: var(--marca); font-weight: 700; }

  @media (max-width: 600px) {
    h1 { font-size: 26px; }
    .resumen { grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
    .resumen div { padding: 12px; }
    .resumen b { font-size: 20px; }
    .ia { flex-wrap: wrap; }
  }
</style>

<script>
  import { todos } from '../scripts/store';
  import { COLOR_TRIAJE, ETIQUETA_ESTADO, ETIQUETA_TRIAJE, TRIAJES, eta, escapar } from '../scripts/formato';

  const $ = (id: string) => document.getElementById(id)!;
  const casos = todos();
  // En atención va primero (ya estás ahí); luego por gravedad y cercanía.
  const activas = casos
    .filter((c) => c.estado === 'asignado' || c.estado === 'en_atencion')
    .sort((a, b) => (a.estado === 'en_atencion' ? -1 : 0) - (b.estado === 'en_atencion' ? -1 : 0) || TRIAJES.indexOf(a.triaje) - TRIAJES.indexOf(b.triaje) || eta(a).min - eta(b).min);
  const resueltas = casos.filter((c) => c.estado === 'resuelto');

  $('r-activas').textContent = String(activas.length);
  $('r-tiempo').textContent = `${activas.filter((c) => c.estado === 'asignado').reduce((t, c) => t + eta(c).min, 0)} min`;
  $('r-resueltas').textContent = String(resueltas.length);

  $('ruta').innerHTML = activas.length
    ? activas
        .map((c, i) => {
          const e = eta(c);
          return `<li>
            <span class="n num" style="background:${COLOR_TRIAJE[c.triaje]}" title="${ETIQUETA_TRIAJE[c.triaje]}">${i + 1}</span>
            <a class="parada" href="/casos/${c.id}">
              <b>${escapar(c.paciente.nombre)}</b>
              <p>${escapar(c.motivo)}</p>
              <small>${escapar(c.direccion)} · ${c.paciente.edad} años</small>
              <div class="lado">
                <span class="min num">${c.estado === 'en_atencion' ? '' : `${e.min}<small> min</small>`}</span>
                <span class="estado ${c.estado}">${ETIQUETA_ESTADO[c.estado]}</span>
              </div>
            </a>
          </li>`;
        })
        .join('')
    : '<p class="vacio">No tienes visitas pendientes. <a href="/casos">Toma un caso</a> o búscalo en el <a href="/">mapa</a>.</p>';

  $('hechas').innerHTML = resueltas.length
    ? resueltas.map((c) => `<li><a href="/casos/${c.id}"><span class="check">✓</span><b>${escapar(c.paciente.nombre)}</b><span>${escapar(c.motivo)}</span></a></li>`).join('')
    : '<p class="vacio">Aún no has cerrado casos hoy.</p>';
</script>
