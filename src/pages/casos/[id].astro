---
import CRM from '../../layouts/CRM.astro';
import { CASOS, type Caso } from '../../data/casos';

export function getStaticPaths() {
  return CASOS.map((caso) => ({ params: { id: caso.id }, props: { caso } }));
}

const { caso } = Astro.props as { caso: Caso };
const p = caso.paciente;
const s = caso.signos;
const signos = [
  { k: 'FC', v: `${s.fc}`, u: 'lpm', alerta: s.fc > 110 },
  { k: 'SpO₂', v: `${s.spo2}`, u: '%', alerta: s.spo2 < 92 },
  { k: 'Presión', v: s.pa, u: 'mmHg', alerta: parseInt(s.pa) >= 160 },
  { k: 'Temp.', v: `${s.temp}`, u: '°C', alerta: s.temp >= 38.5 },
];
const pasos = [
  { id: 'pendiente', t: 'Sin asignar' },
  { id: 'asignado', t: 'En camino' },
  { id: 'en_atencion', t: 'En atención' },
  { id: 'resuelto', t: 'Resuelto' },
];
---
<CRM titulo={p.nombre} activa="casos">
  <div class="ficha" data-id={caso.id}>
    <a class="volver" href="/casos">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
      Casos
    </a>

    <header class="cabecera tarjeta" id="cabecera" data-triaje={caso.triaje}>
      <div class="identidad">
        <div class="etiquetas">
          <span class="triaje" id="f-triaje">—</span>
          <span class="estado" id="f-estado">—</span>
          <span class="meta num">{caso.id} · {caso.canal} · <span id="f-hace"></span></span>
        </div>
        <h1>{p.nombre}</h1>
        <p class="datos num">{p.edad} años · {p.sexo === 'F' ? 'Femenino' : 'Masculino'} · C.C. {p.cedula} · {p.eps}</p>
        <p class="direccion">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
          {caso.direccion}, Cali · <b class="num" id="f-eta"></b>
        </p>
      </div>
      <div class="acciones">
        <button class="principal" id="f-principal">Tomar caso</button>
        <div class="secundarias">
          <a class="sec" href={`tel:${p.telefono.replace(/\s/g, '')}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
            Llamar
          </a>
          <a class="sec" href={`/?caso=${caso.id}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
            Ver en mapa
          </a>
          <button class="sec" id="f-liberar" hidden>Liberar caso</button>
        </div>
      </div>
      <ol class="pasos" id="pasos">
        {pasos.map((x) => <li data-paso={x.id}><i></i>{x.t}</li>)}
      </ol>
    </header>

    <div class="rejilla">
      <div class="col">
        <section class="tarjeta">
          <h2>Signos vitales <small>al momento del reporte</small></h2>
          <div class="signos">
            {signos.map((x) => (
              <div class:list={['signo', { alerta: x.alerta }]}>
                <span>{x.k}</span>
                <b class="num">{x.v}<small>{x.u}</small></b>
                {x.alerta && <em>Fuera de rango</em>}
              </div>
            ))}
          </div>
        </section>

        <section class="tarjeta">
          <h2>Motivo de consulta</h2>
          <p class="motivo">{caso.motivo}</p>
          <p class="texto">{caso.descripcion}</p>
        </section>

        <section class="tarjeta">
          <h2>Antecedentes</h2>
          <dl class="antecedentes">
            <div><dt>Enfermedades</dt><dd>{p.antecedentes.length ? p.antecedentes.map((a) => <span class="tag">{a}</span>) : <span class="nada">Ninguna reportada</span>}</dd></div>
            <div><dt>Alergias</dt><dd>{p.alergias.length ? p.alergias.map((a) => <span class="tag alergia">{a}</span>) : <span class="nada">Sin alergias conocidas</span>}</dd></div>
            <div><dt>Medicamentos</dt><dd>{p.medicamentos.length ? p.medicamentos.map((a) => <span class="tag">{a}</span>) : <span class="nada">Ninguno</span>}</dd></div>
          </dl>
        </section>

        <section class="tarjeta">
          <h2>Contacto</h2>
          <div class="contactos">
            <div>
              <span>Paciente</span>
              <b class="num">{p.telefono}</b>
            </div>
            <div>
              <span>{p.contacto.parentesco}: {p.contacto.nombre}</span>
              <b class="num">{p.contacto.telefono}</b>
            </div>
          </div>
        </section>

        <section class="tarjeta">
          <h2>Reclasificar triaje</h2>
          <p class="texto">Si al valorar al paciente la urgencia cambió, actualízala para que el resto del equipo lo vea en el mapa.</p>
          <div class="reclasificar" id="reclasificar">
            <button data-t="critico"><i></i>Crítico</button>
            <button data-t="moderado"><i></i>Moderado</button>
            <button data-t="estable"><i></i>Estable</button>
          </div>
        </section>
      </div>

      <div class="col">
        <section class="tarjeta ia">
          <h2>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 5.4L19 9l-5.2 1.6L12 16l-1.8-5.4L5 9l5.2-1.6zM19 15l.9 2.6 2.6.9-2.6.9L19 22l-.9-2.6-2.6-.9 2.6-.9z"/></svg>
            Resumen clínico con IA
            <span class="pronto">Próximamente</span>
          </h2>
          <div class="borroso" aria-hidden="true">
            <p>Paciente de {p.edad} años con {caso.motivo.toLowerCase()}. Riesgo estimado según antecedentes y signos vitales…</p>
            <p>Sugerencias de manejo inicial y exámenes a solicitar en la visita…</p>
          </div>
          <p class="texto">Aquí verás un resumen de la historia, el riesgo estimado y qué revisar primero antes de llegar.</p>
        </section>

        <section class="tarjeta pestanas">
          <div class="tabs" role="tablist">
            <button role="tab" aria-selected="true" data-tab="historial">Historial</button>
            <button role="tab" aria-selected="false" data-tab="notas">Notas <b class="num" id="n-notas"></b></button>
            <button role="tab" aria-selected="false" data-tab="mensajes">Mensajes <b class="num" id="n-mensajes"></b></button>
            <button role="tab" aria-selected="false" data-tab="documentos">Documentos <b class="num" id="n-docs"></b></button>
          </div>

          <div class="panel" data-panel="historial">
            <ol class="linea" id="linea"></ol>
          </div>

          <div class="panel" data-panel="notas" hidden>
            <form class="escribir" id="form-nota">
              <textarea id="nota" rows="3" placeholder="Nota interna: solo la ve el equipo médico"></textarea>
              <button type="submit">Guardar nota</button>
            </form>
            <ul class="notas" id="notas"></ul>
          </div>

          <div class="panel" data-panel="mensajes" hidden>
            <p class="aviso">Conversación con {p.contacto.parentesco.toLowerCase()} ({p.contacto.nombre}). <span class="pronto">WhatsApp real próximamente</span></p>
            <div class="chat" id="chat"></div>
            <form class="enviar" id="form-msg">
              <input id="msg" placeholder="Escribe un mensaje…" autocomplete="off" />
              <button type="submit" aria-label="Enviar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20l18-8L3 4l2 7 9 1-9 1z"/></svg>
              </button>
            </form>
            <div class="rapidos">
              <button data-rapido="Voy en camino, llego en unos minutos.">Voy en camino</button>
              <button data-rapido="Por favor tengan listos los medicamentos que está tomando.">Tener medicamentos listos</button>
              <button data-rapido="¿Cómo sigue el paciente? ¿Algún cambio?">¿Cómo sigue?</button>
            </div>
          </div>

          <div class="panel" data-panel="documentos" hidden>
            <ul class="docs" id="docs">
              {caso.documentos.map((d) => (
                <li>
                  <span class="icono-doc">PDF</span>
                  <div><b>{d.nombre}</b><small>{d.tipo} · hace {d.haceDias} d</small></div>
                  <span class:list={['estado-doc', d.estado.toLowerCase()]}>{d.estado}</span>
                </li>
              ))}
            </ul>
            <label class="subir">
              <input type="file" id="archivo" hidden />
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 16V4M6 10l6-6 6 6M4 20h16"/></svg>
              Adjuntar documento
            </label>
            <p class="aviso">Lectura automática de exámenes con IA <span class="pronto">Próximamente</span></p>
          </div>
        </section>
      </div>
    </div>
  </div>
</CRM>

<style>
  .ficha { max-width: 1240px; margin: 0 auto; }
  .volver { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 14px; color: var(--tinta-2); font-size: 14px; font-weight: 700; text-decoration: none; }
  .volver:hover { color: var(--marca); }
  .tarjeta { padding: 20px 22px; border-radius: 18px; background: var(--superficie); border: 1px solid var(--borde); }
  h2 { display: flex; align-items: center; gap: 8px; margin: 0 0 14px; font-size: 16px; font-weight: 800; }
  h2 small { font-size: 12px; font-weight: 600; color: var(--tinta-3); }
  .texto { margin: 0; font-size: 14px; line-height: 1.55; color: var(--tinta-2); }

  /* Cabecera */
  .cabecera { display: grid; grid-template-columns: 1fr auto; gap: 18px 24px; border-top: 5px solid var(--c, var(--critico)); }
  .cabecera[data-triaje='critico'] { --c: var(--critico); }
  .cabecera[data-triaje='moderado'] { --c: var(--moderado); }
  .cabecera[data-triaje='estable'] { --c: var(--estable); }
  .etiquetas { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .triaje { padding: 4px 11px; border-radius: 999px; background: var(--c); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  [data-triaje='moderado'] .triaje { color: #4a2f00; }
  .meta { font-size: 13px; color: var(--tinta-3); font-weight: 600; }
  h1 { margin: 10px 0 0; font-size: 30px; font-weight: 800; letter-spacing: -0.02em; }
  .datos { margin: 4px 0 0; font-size: 14px; color: var(--tinta-2); font-weight: 500; }
  .direccion { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin: 10px 0 0; font-size: 14px; color: var(--tinta-2); }
  .direccion b { color: var(--marca-fuerte); }
  .acciones { display: grid; gap: 8px; align-content: start; min-width: 250px; }
  .principal {
    height: 50px; padding: 0 22px; border: 0; border-radius: 14px; background: linear-gradient(90deg, var(--marca), #16a3a0);
    color: #fff; font-size: 16px; font-weight: 800; box-shadow: 0 8px 18px rgba(14, 124, 134, 0.28);
  }
  .principal.urgente { background: linear-gradient(90deg, #d93a40, var(--critico)); box-shadow: 0 8px 18px rgba(229, 72, 77, 0.28); }
  .principal:disabled { background: #e8f6ee; color: #1f7a4d; box-shadow: none; cursor: default; }
  .secundarias { display: flex; gap: 8px; }
  .sec {
    flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 40px; padding: 0 12px;
    border: 1.5px solid var(--borde); border-radius: 12px; background: #fff; color: var(--tinta); font-size: 13px; font-weight: 700; text-decoration: none; white-space: nowrap;
  }
  .sec:hover { border-color: var(--marca); color: var(--marca); }
  .sec[hidden] { display: none; }

  .pasos { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; padding: 0; list-style: none; }
  .pasos li { position: relative; display: grid; justify-items: center; gap: 8px; font-size: 12px; font-weight: 700; color: var(--tinta-3); text-align: center; }
  .pasos li::before { content: ''; position: absolute; top: 8px; left: -50%; right: 50%; height: 3px; background: var(--borde); }
  .pasos li:first-child::before { display: none; }
  .pasos i { position: relative; width: 19px; height: 19px; border-radius: 50%; background: #fff; border: 3px solid var(--borde); }
  .pasos .hecho { color: var(--tinta); }
  .pasos .hecho::before, .pasos .actual::before { background: var(--marca); }
  .pasos .hecho i { background: var(--marca); border-color: var(--marca); }
  .pasos .actual { color: var(--marca-fuerte); }
  .pasos .actual i { border-color: var(--marca); box-shadow: 0 0 0 5px var(--marca-suave); }


  .rejilla { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 16px; margin-top: 16px; align-items: start; }
  .col { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; min-width: 0; }

  .signos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .signo { display: grid; gap: 2px; padding: 12px; border-radius: 12px; background: var(--fondo); }
  .signo span { font-size: 12px; font-weight: 700; color: var(--tinta-3); }
  .signo b { font-size: 22px; font-weight: 800; }
  .signo b small { margin-left: 3px; font-size: 11px; font-weight: 600; color: var(--tinta-3); }
  .signo em { font-style: normal; font-size: 11px; font-weight: 700; }
  .signo.alerta { background: #fff1f1; box-shadow: inset 0 0 0 1px rgba(229, 72, 77, 0.3); }
  .signo.alerta b, .signo.alerta em { color: var(--critico); }
  .motivo { margin: 0 0 6px; font-size: 18px; font-weight: 700; }

  .antecedentes { display: grid; gap: 12px; margin: 0; }
  .antecedentes dt { font-size: 12px; font-weight: 700; color: var(--tinta-3); margin-bottom: 6px; }
  .antecedentes dd { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }
  .tag { padding: 5px 10px; border-radius: 8px; background: var(--fondo); font-size: 13px; font-weight: 600; }
  .tag.alergia { background: #fff1f1; color: #c2353a; }
  .nada { font-size: 13px; color: var(--tinta-3); }

  .contactos { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .contactos div { display: grid; gap: 2px; padding: 12px; border-radius: 12px; background: var(--fondo); }
  .contactos span { font-size: 12px; color: var(--tinta-3); font-weight: 600; }
  .contactos b { font-size: 15px; }

  .reclasificar { display: flex; gap: 8px; margin-top: 12px; }
  .reclasificar button { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 40px; border: 1.5px solid var(--borde); border-radius: 12px; background: #fff; font-size: 13px; font-weight: 700; }
  .reclasificar i { width: 9px; height: 9px; border-radius: 50%; }
  .reclasificar [data-t='critico'] i { background: var(--critico); }
  .reclasificar [data-t='moderado'] i { background: var(--moderado); }
  .reclasificar [data-t='estable'] i { background: var(--estable); }
  .reclasificar button[aria-pressed='true'] { border-color: var(--tinta); background: var(--fondo); }

  .ia { background: linear-gradient(135deg, #f7f4ff, #f0f9f9); border-color: #e4dcfb; }
  .ia h2 { color: #5a3fc0; }
  .ia .pronto { margin-left: auto; }
  .borroso { filter: blur(4px); user-select: none; margin-bottom: 10px; }
  .borroso p { margin: 0 0 6px; font-size: 14px; color: var(--tinta-2); }

  /* Pestañas */
  .tabs { display: flex; gap: 4px; margin: -6px -8px 16px; padding-bottom: 10px; border-bottom: 1px solid var(--borde); overflow-x: auto; }
  .tabs button { height: 36px; padding: 0 12px; border: 0; border-radius: 10px; background: none; color: var(--tinta-3); font-size: 14px; font-weight: 700; white-space: nowrap; }
  .tabs button[aria-selected='true'] { background: var(--marca-suave); color: var(--marca-fuerte); }
  .tabs b { margin-left: 2px; font-size: 12px; }
  .panel[hidden] { display: none; }

  .linea { list-style: none; margin: 0; padding: 0; display: grid; }
  .linea :global(li) { position: relative; display: grid; gap: 2px; padding: 0 0 18px 26px; }
  .linea :global(li::before) { content: ''; position: absolute; left: 6px; top: 16px; bottom: 0; width: 2px; background: var(--borde); }
  .linea :global(li:last-child::before) { display: none; }
  .linea :global(li i) { position: absolute; left: 0; top: 3px; width: 14px; height: 14px; border-radius: 50%; background: #fff; border: 3px solid var(--marca); }
  .linea :global(li b) { font-size: 14px; font-weight: 600; }
  .linea :global(li small) { font-size: 12px; color: var(--tinta-3); }

  .escribir { display: grid; gap: 8px; margin-bottom: 14px; }
  textarea, .enviar input {
    width: 100%; padding: 12px 14px; border: 1.5px solid var(--borde); border-radius: 12px; background: var(--fondo);
    font: inherit; font-size: 14px; color: var(--tinta); outline: none; resize: vertical;
  }
  textarea:focus, .enviar input:focus { border-color: var(--marca); background: #fff; }
  .escribir button { justify-self: end; height: 40px; padding: 0 18px; border: 0; border-radius: 10px; background: var(--marca); color: #fff; font-weight: 800; font-size: 14px; }
  .notas { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .notas :global(li) { padding: 12px 14px; border-radius: 12px; background: #fffbea; border: 1px solid #f6e7a6; }
  .notas :global(li p) { margin: 0 0 6px; font-size: 14px; line-height: 1.5; white-space: pre-wrap; }
  .notas :global(li small) { font-size: 12px; color: var(--tinta-3); }

  .aviso { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 12px; font-size: 13px; color: var(--tinta-3); }
  .chat { display: grid; gap: 8px; max-height: 320px; overflow-y: auto; padding: 4px 2px 12px; }
  .chat :global(.burbuja) { max-width: 80%; padding: 10px 12px; border-radius: 14px; font-size: 14px; line-height: 1.45; }
  .chat :global(.burbuja small) { display: block; margin-top: 4px; font-size: 11px; opacity: 0.7; }
  .chat :global(.medico) { justify-self: end; background: var(--marca); color: #fff; border-bottom-right-radius: 4px; }
  .chat :global(.familiar) { justify-self: start; background: var(--fondo); border-bottom-left-radius: 4px; }
  .chat :global(.escribiendo) { justify-self: start; font-size: 12px; color: var(--tinta-3); }
  .enviar { display: flex; gap: 8px; }
  .enviar button { width: 46px; flex: none; border: 0; border-radius: 12px; background: var(--marca); color: #fff; display: grid; place-items: center; }
  .rapidos { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .rapidos button { padding: 6px 10px; border: 1px solid var(--borde); border-radius: 999px; background: #fff; font-size: 12px; font-weight: 600; color: var(--tinta-2); }

  .docs { list-style: none; margin: 0 0 12px; padding: 0; display: grid; gap: 8px; }
  .docs :global(li) { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 12px; border: 1px solid var(--borde); }
  .docs :global(.icono-doc) { width: 38px; height: 44px; flex: none; display: grid; place-items: center; border-radius: 8px; background: #fdecec; color: #c2353a; font-size: 10px; font-weight: 800; }
  .docs :global(li div) { flex: 1; min-width: 0; }
  .docs :global(li b) { display: block; font-size: 14px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .docs :global(li small) { font-size: 12px; color: var(--tinta-3); }
  .docs :global(.estado-doc) { padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 800; }
  .docs :global(.aprobado) { background: #e8f6ee; color: #1f7a4d; }
  .docs :global(.pendiente) { background: #fff4de; color: #9a6200; }
  .docs :global(.rechazado) { background: #fdecec; color: #c2353a; }
  .subir {
    display: flex; align-items: center; justify-content: center; gap: 8px; height: 48px; margin-bottom: 12px;
    border: 1.5px dashed #b9cfd1; border-radius: 12px; color: var(--marca); font-size: 14px; font-weight: 700; cursor: pointer;
  }
  .subir:hover { background: var(--marca-suave); }

  @media (max-width: 1100px) {
    .rejilla { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 700px) {
    .cabecera { grid-template-columns: 1fr; padding: 18px; }
    .acciones { min-width: 0; }
    h1 { font-size: 24px; }
    .signos { grid-template-columns: repeat(2, 1fr); }
    .contactos { grid-template-columns: 1fr; }
    .pasos li { font-size: 11px; }
    .tarjeta { padding: 18px; }
  }
</style>

<script>
  import type { Estado, Triaje } from '../../data/casos';
  import { uno, cambios, cambiarEstado, reclasificar, agregarNota, agregarMensaje, subirDocumento, creadoEn } from '../../scripts/store';
  import { ETIQUETA_ESTADO, ETIQUETA_TRIAJE, eta, hace, escapar, avisar } from '../../scripts/formato';
  import { CASOS, DOCTOR } from '../../data/casos';

  const id = document.querySelector<HTMLElement>('.ficha')!.dataset.id!;
  const $ = (i: string) => document.getElementById(i)!;
  const ORDEN: Estado[] = ['pendiente', 'asignado', 'en_atencion', 'resuelto'];
  const minDesde = (t: number) => (Date.now() - t) / 60000;

  const SIGUIENTE: Record<Estado, { estado: Estado; texto: string } | null> = {
    pendiente: { estado: 'asignado', texto: 'Tomar caso' },
    asignado: { estado: 'en_atencion', texto: 'Llegué · iniciar atención' },
    en_atencion: { estado: 'resuelto', texto: 'Cerrar caso como resuelto' },
    resuelto: null,
  };

  function pintar() {
    const c = uno(id)!;
    const ch = cambios(id);

    const cab = $('cabecera');
    cab.dataset.triaje = c.triaje;
    $('f-triaje').textContent = ETIQUETA_TRIAJE[c.triaje];
    $('f-estado').className = `estado ${c.estado}`;
    $('f-estado').textContent = ETIQUETA_ESTADO[c.estado];
    $('f-hace').textContent = hace(minDesde(creadoEn(c)));
    const e = eta(c);
    $('f-eta').textContent = `${e.texto} · ${e.min} min`;

    const sig = SIGUIENTE[c.estado];
    const btn = $('f-principal') as HTMLButtonElement;
    btn.disabled = !sig;
    btn.textContent = sig ? (c.estado === 'pendiente' && c.triaje === 'critico' ? 'Tomar caso urgente' : sig.texto) : 'Caso resuelto ✓';
    btn.classList.toggle('urgente', c.estado === 'pendiente' && c.triaje === 'critico');
    $('f-liberar').hidden = c.estado !== 'asignado';

    const i = ORDEN.indexOf(c.estado);
    document.querySelectorAll<HTMLElement>('#pasos li').forEach((li, n) => {
      li.classList.toggle('hecho', n < i || (n === i && c.estado === 'resuelto'));
      li.classList.toggle('actual', n === i && c.estado !== 'resuelto');
    });

    document.querySelectorAll<HTMLElement>('#reclasificar button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.t === c.triaje)));

    // Historial: lo que trae el caso + lo que pasó en esta demo
    const base = [
      { texto: `Caso creado desde ${c.canal}`, en: creadoEn(c) },
      { texto: `Triaje inicial: ${ETIQUETA_TRIAJE[CASOS.find((x) => x.id === id)!.triaje]}`, en: creadoEn(c) + 1000 },
    ];
    if (!ch.eventos?.length && c.estado !== 'pendiente') {
      base.push({ texto: `${DOCTOR.nombre} tomó el caso`, en: creadoEn(c) + 12 * 60000 });
      if (c.estado !== 'asignado') base.push({ texto: `${DOCTOR.nombre} llegó y empezó la atención`, en: creadoEn(c) + 30 * 60000 });
      if (c.estado === 'resuelto') base.push({ texto: 'Caso cerrado como resuelto', en: creadoEn(c) + 70 * 60000 });
    }
    const eventos = [...base, ...(ch.eventos ?? [])].sort((a, b) => b.en - a.en);
    $('linea').innerHTML = eventos.map((ev) => `<li><i></i><b>${escapar(ev.texto)}</b><small>${hace(minDesde(ev.en))}</small></li>`).join('');

    const notas = [...(ch.notas ?? [])].reverse();
    $('notas').innerHTML = notas.length
      ? notas.map((n) => `<li><p>${escapar(n.texto)}</p><small>${escapar(n.autor)} · ${hace(minDesde(n.en))}</small></li>`).join('')
      : '<li style="background:none;border:1px dashed var(--borde)"><small>Todavía no hay notas internas.</small></li>';
    $('n-notas').textContent = notas.length ? String(notas.length) : '';

    const msgs = ch.mensajes ?? [];
    $('chat').innerHTML = msgs.length
      ? msgs.map((m) => `<div class="burbuja ${m.de}">${escapar(m.texto)}<small>${hace(minDesde(m.en))}</small></div>`).join('')
      : '<p class="escribiendo">Aún no hay mensajes. Escríbele a la familia para avisar que vas en camino.</p>';
    $('n-mensajes').textContent = msgs.length ? String(msgs.length) : '';
    $('chat').scrollTop = $('chat').scrollHeight;

    const extra = document.querySelectorAll('#docs li[data-subido]');
    extra.forEach((x) => x.remove());
    (ch.documentos ?? []).forEach((d) => {
      $('docs').insertAdjacentHTML('beforeend', `<li data-subido><span class="icono-doc">DOC</span><div><b>${escapar(d.nombre)}</b><small>Adjuntado ${hace(minDesde(d.en))}</small></div><span class="estado-doc pendiente">Pendiente</span></li>`);
    });
    $('n-docs').textContent = String($('docs').children.length);
  }

  $('f-principal').addEventListener('click', () => {
    const c = uno(id)!;
    const sig = SIGUIENTE[c.estado];
    if (!sig) return;
    cambiarEstado(id, sig.estado);
    avisar(
      sig.estado === 'asignado' ? `Caso tomado · te esperan en ~${eta(c).min} min`
      : sig.estado === 'en_atencion' ? 'Atención iniciada'
      : 'Caso resuelto. ¡Buen trabajo!',
    );
    pintar();
  });

  $('f-liberar').addEventListener('click', () => {
    cambiarEstado(id, 'pendiente');
    avisar('Liberaste el caso: vuelve a estar disponible para otros médicos');
    pintar();
  });

  document.querySelectorAll<HTMLButtonElement>('#reclasificar button').forEach((b) =>
    b.addEventListener('click', () => {
      const t = b.dataset.t as Triaje;
      if (uno(id)!.triaje === t) return;
      reclasificar(id, t);
      avisar(`Triaje actualizado a ${ETIQUETA_TRIAJE[t]}`);
      pintar();
    }),
  );

  // Pestañas
  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
      if (b.dataset.tab === 'mensajes') $('chat').scrollTop = $('chat').scrollHeight;
    }),
  );

  $('form-nota').addEventListener('submit', (e) => {
    e.preventDefault();
    const t = ($('nota') as HTMLTextAreaElement).value.trim();
    if (!t) return;
    agregarNota(id, t);
    ($('nota') as HTMLTextAreaElement).value = '';
    avisar('Nota guardada');
    pintar();
  });

  // Mensajes: la respuesta de la familia es simulada mientras llega WhatsApp.
  const RESPUESTAS = ['Gracias doctor, aquí lo esperamos.', 'Listo doctor, ya tenemos todo a la mano.', 'Sigue igual, un poco cansado. Gracias por venir.'];
  function enviar(texto: string) {
    if (!texto.trim()) return;
    agregarMensaje(id, { de: 'medico', texto: texto.trim(), en: Date.now() });
    pintar();
    $('chat').insertAdjacentHTML('beforeend', '<p class="escribiendo" id="escribiendo">Escribiendo…</p>');
    $('chat').scrollTop = $('chat').scrollHeight;
    setTimeout(() => {
      agregarMensaje(id, { de: 'familiar', texto: RESPUESTAS[Math.floor(Math.random() * RESPUESTAS.length)], en: Date.now() });
      pintar();
    }, 1600);
  }
  $('form-msg').addEventListener('submit', (e) => {
    e.preventDefault();
    const input = $('msg') as HTMLInputElement;
    enviar(input.value);
    input.value = '';
  });
  document.querySelectorAll<HTMLButtonElement>('[data-rapido]').forEach((b) => b.addEventListener('click', () => enviar(b.dataset.rapido!)));

  $('archivo').addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (!f) return;
    subirDocumento(id, f.name);
    avisar('Documento adjuntado, queda pendiente de revisión');
    pintar();
  });

  pintar();
</script>
