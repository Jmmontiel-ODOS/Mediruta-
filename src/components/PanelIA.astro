---
// Funciones de IA que vienen después del MVP. Se muestran, pero no hacen nada.
const funciones = [
  { titulo: 'Triaje automático', texto: 'Clasifica al paciente por síntomas y signos vitales.' },
  { titulo: 'Ruta óptima', texto: 'Ordena tus visitas por gravedad y tráfico.' },
  { titulo: 'Alerta de empeoramiento', texto: 'Avisa si un paciente amarillo se está poniendo rojo.' },
  { titulo: 'Resumen de historia', texto: 'Lo importante del paciente en tres líneas antes de llegar.' },
];
---
<aside class="panel" id="panel-ia">
  <button class="abrir flotante" id="panel-ia-btn" aria-expanded="false" aria-controls="panel-ia-lista">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.8 5.4L19 9l-5.2 1.6L12 16l-1.8-5.4L5 9l5.2-1.6zM19 15l.9 2.6 2.6.9-2.6.9L19 22l-.9-2.6-2.6-.9 2.6-.9z"/></svg>
    <span>Copiloto IA</span>
    <span class="pronto">Pronto</span>
  </button>
  <div class="lista flotante" id="panel-ia-lista" hidden>
    <p class="intro">Estamos entrenando a MediRuta para ayudarte a decidir más rápido.</p>
    <ul>
      {funciones.map((f) => (
        <li>
          <b>{f.titulo}</b>
          <span>{f.texto}</span>
        </li>
      ))}
    </ul>
    <span class="pronto">Próximamente</span>
  </div>
</aside>

<style>
  .panel {
    position: fixed;
    right: 16px;
    bottom: 120px;
    z-index: 20;
    display: grid;
    justify-items: end;
    gap: 8px;
  }
  .abrir {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 14px;
    font-size: 14px;
    font-weight: 700;
    color: #5a3fc0;
  }
  .lista { order: -1; width: 290px; padding: 16px; animation: entra 0.2s ease-out; }
  .lista[hidden] { display: none; }
  @keyframes entra { from { opacity: 0; transform: translateY(8px); } }
  .intro { margin: 0 0 12px; font-size: 13px; color: var(--tinta-2); }
  ul { list-style: none; margin: 0 0 12px; padding: 0; display: grid; gap: 10px; }
  li { display: grid; gap: 2px; padding-left: 12px; border-left: 3px solid #d9cffb; }
  li b { font-size: 14px; }
  li span { font-size: 12px; color: var(--tinta-3); }
  @media (max-width: 600px) {
    .panel { right: 12px; bottom: 108px; }
    .abrir span:not(.pronto) { display: none; }
    .lista { width: min(290px, calc(100vw - 24px)); }
  }
</style>

<script>
  const btn = document.getElementById('panel-ia-btn')!;
  const lista = document.getElementById('panel-ia-lista')!;
  btn.addEventListener('click', () => {
    const abierto = lista.hidden;
    lista.hidden = !abierto;
    btn.setAttribute('aria-expanded', String(abierto));
  });
</script>
